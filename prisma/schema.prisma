generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String            @id @default(uuid())
  puskesmasId            String
  name                   String
  email                  String            @unique
  password               String
  role                   String            @default("staff")
  isActive               Boolean           @default(true)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  createdMasterPelayanan MasterPelayanan[] @relation("CreatedByMaster")
  createdRekapPelayanan  RekapPelayanan[]  @relation("CreatedByRekap")

  @@index([puskesmasId])
  @@map("users")
}

model MasterPelayanan {
  id              String            @id @default(uuid())
  puskesmasId     String
  kategori        String
  jenisPelayanan  String
  tarif           Decimal           @db.Decimal(12, 2)
  satuan          String?
  createdById     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  detailPelayanan DetailPelayanan[]
  createdBy       User?             @relation("CreatedByMaster", fields: [createdById], references: [id])

  @@index([puskesmasId])
  @@map("master_pelayanan")
}

model RekapPelayanan {
  id                    String            @id @default(uuid())
  puskesmasId           String
  noKwitansi            String            @unique
  tanggal               DateTime
  nama                  String
  alamat                String
  jenisKelamin          String
  usia                  Int
  nomorRm               String
  sumberPendanaan       String
  metodePembayaran      String
  totalTarifKeseluruhan Decimal           @db.Decimal(12, 2)
  createdById           String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  detailPelayanan       DetailPelayanan[]
  createdBy             User?             @relation("CreatedByRekap", fields: [createdById], references: [id])

  @@unique([puskesmasId, noKwitansi])
  @@index([puskesmasId])
  @@map("rekap_pelayanan")
}

model DetailPelayanan {
  id                     String          @id @default(uuid())
  rekapPelayananId       String
  masterPelayananId      String
  jenisPelayananSnapshot String
  tarifDasar             Decimal         @db.Decimal(12, 2)
  qtyKilometer           Decimal         @db.Decimal(10, 2)
  subtotal               Decimal         @db.Decimal(12, 2)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  masterPelayanan        MasterPelayanan @relation(fields: [masterPelayananId], references: [id])
  rekapPelayanan         RekapPelayanan  @relation(fields: [rekapPelayananId], references: [id], onDelete: Cascade)

  @@map("detail_pelayanan")
}
